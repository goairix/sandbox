# Sandbox Docker Compose Environment Variables
# Copy this file to .env and fill in the selected backend values.

# One release selects exactly one backend preset. Provider and s3fs profile are
# derived by the container entrypoint and cannot be independently overridden.
STORAGE_PRESET=minio
STORAGE_BUCKET=
# Optional. MinIO defaults to us-east-1; standard Huawei OBS endpoints derive it.
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_SUB_PATH=
STORAGE_USE_SSL=true
STORAGE_IDENTITY=local-minio
# Optional pool rotation label. Change it when rotating AK/SK so old prepared
# FUSE shells are drained instead of reused.
WORKSPACE_CREDENTIAL_GENERATION=local-v1

# Requests without workspace_mount_mode use the default. To enable both modes,
# set WORKSPACE_ENABLED_MOUNT_MODES=sync,fuse; either may be the default.
WORKSPACE_DEFAULT_MOUNT_MODE=sync
WORKSPACE_ENABLED_MOUNT_MODES=sync

# FUSE uses one common image per runtime across all three presets.
FUSE_MOUNTER_IMAGE=registry.i.huaxisy.com/library/ai-infra/sandbox-fuse-mounter:v0.2.12
FUSE_SANDBOX_IMAGE=registry.i.huaxisy.com/library/ai-infra/sandbox-fuse-docker:v0.2.12
WORKSPACE_CACHE_SIZE=2Gi
WORKSPACE_MOUNT_TIMEOUT_SECONDS=30
WORKSPACE_FLUSH_TIMEOUT_SECONDS=30
WORKSPACE_UNMOUNT_TIMEOUT_SECONDS=15
WORKSPACE_LEASE_TTL_SECONDS=120
WORKSPACE_LEASE_RENEW_INTERVAL_SECONDS=30
FUSE_POOL_MIN_SIZE=1
FUSE_POOL_MAX_SIZE=3
FUSE_POOL_REFILL_INTERVAL_SECONDS=10
FUSE_POOL_PREPARE_TIMEOUT_SECONDS=120

# Versioned project images. Multi-architecture manifests are published under
# the same release tag. Empty runtime/gateway values are built locally for
# development only.
SANDBOX_API_IMAGE=registry.i.huaxisy.com/library/ai-infra/sandbox-api:v0.2.12
SANDBOX_IMAGE=registry.i.huaxisy.com/library/ai-infra/sandbox-runtime:v0.2.12
GATEWAY_IMAGE=registry.i.huaxisy.com/library/ai-infra/sandbox-gateway:v0.2.12
DOCKER_AUTH_CONFIG_FILE=./docker-auth-public/config.json

# Redis state store
REDIS_PASSWORD=
REDIS_DB=0

# API authentication and sizing
SECURITY_API_KEY=change-me
SANDBOX_TIMEOUT_SECONDS=3600
POOL_MIN_SIZE=3
POOL_MAX_SIZE=20

# Telemetry
TELEMETRY_TRACER_ENABLED=false
TELEMETRY_TRACER_ENDPOINT=
TELEMETRY_METRICS_ENABLED=false
TELEMETRY_METRICS_ENDPOINT=
TELEMETRY_LOG_ENABLED=false
TELEMETRY_LOG_ENDPOINT=
