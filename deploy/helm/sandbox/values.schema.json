{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "redis": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "mode": {"enum": ["standalone", "sentinel"]},
        "sentinel": {
          "type": "object",
          "additionalProperties": false,
          "required": ["masterName", "clusterDomain", "identitySecretName", "existingSecret", "dataPasswordKey", "sentinelPasswordKey", "password", "startupTimeoutSeconds", "initializeTimeoutSeconds", "ackTimeoutMs", "downAfterMilliseconds", "failoverTimeoutMilliseconds", "parallelSyncs", "resources", "identityResources"],
          "properties": {
            "masterName": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
            "clusterDomain": {"type": "string", "maxLength": 128, "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)*$"},
            "identitySecretName": {"type": "string", "maxLength": 253, "pattern": "^$|^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)*$"},
            "existingSecret": {"type": "string", "maxLength": 253, "pattern": "^$|^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)*$"},
            "dataPasswordKey": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[A-Za-z0-9_.-]+$"},
            "sentinelPasswordKey": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[A-Za-z0-9_.-]+$"},
            "password": {"type": "string"},
            "startupTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 600},
            "initializeTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 720},
            "ackTimeoutMs": {"type": "integer", "minimum": 1000, "maximum": 10000},
            "downAfterMilliseconds": {"type": "integer", "minimum": 1000, "maximum": 60000},
            "failoverTimeoutMilliseconds": {"type": "integer", "minimum": 2000, "maximum": 600000},
            "parallelSyncs": {"type": "integer", "minimum": 1, "maximum": 2},
            "resources": {"type": "object"},
            "identityResources": {"type": "object"}
          }
        }
      }
    },
    "apparmorLoader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "image", "resources", "checkIntervalSeconds", "parserTimeoutSeconds", "startupTimeoutSeconds"],
      "properties": {
        "enabled": {"type": "boolean"},
        "priorityClassName": {"type": "string", "maxLength": 253, "pattern": "^$|^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)*$"},
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": {"type": "string", "minLength": 1},
            "tag": {"type": "string", "minLength": 1},
            "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
          }
        },
        "resources": {"type": "object"},
        "checkIntervalSeconds": {"type": "integer", "minimum": 1, "maximum": 600},
        "parserTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 600},
        "startupTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 600}
      }
    },
    "config": {
      "type": "object",
      "required": ["storage", "workspace"],
      "properties": {
        "runtime": {
          "type": "object",
          "properties": {
            "kubernetes": {
              "type": "object",
              "properties": {
                "nodeSelector": {"type": "object", "maxProperties": 64, "additionalProperties": {"type": "string"}}
              }
            }
          }
        },
        "storage": {
          "type": "object",
          "required": ["filesystem"],
          "properties": {
            "filesystem": {
              "type": "object",
              "additionalProperties": false,
              "required": ["preset", "bucket", "endpoint", "accessKey", "secretKey", "storageIdentity", "credentialGeneration"],
              "properties": {
                "preset": {"enum": ["minio", "huawei-obs-public", "huawei-obs-private"]},
                "bucket": {"type": "string", "minLength": 1},
                "endpoint": {"type": "string", "minLength": 1},
                "accessKey": {"type": "string"},
                "secretKey": {"type": "string"},
                "storageIdentity": {"type": "string", "minLength": 1},
                "credentialGeneration": {"type": "string", "minLength": 1},
                "region": {"type": "string"},
                "subPath": {"type": "string"},
                "useSSL": {"type": "boolean"}
              }
            }
          }
        },
        "workspace": {
          "type": "object",
          "additionalProperties": false,
          "required": ["defaultMountMode", "enabledMountModes", "fuseImages"],
          "properties": {
            "defaultMountMode": {"enum": ["sync", "fuse"]},
            "enabledMountModes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "uniqueItems": true,
              "items": {"enum": ["sync", "fuse"]}
            },
            "fuseImages": {
              "type": "object",
              "required": ["mounter", "docker"],
              "properties": {
                "mounter": {"type": "string", "pattern": "^(?:[^\\s@]+@sha256:[0-9a-f]{64}|[^\\s@]+:v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?)$"},
                "docker": {"type": "string", "pattern": "^(?:[^\\s@]+@sha256:[0-9a-f]{64}|[^\\s@]+:v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?)$"}
              }
            },
            "allowMissingLSMForKind": {"type": "boolean"},
            "autoSyncIntervalSeconds": {"type": "integer", "minimum": 0},
            "cacheSize": {"type": "string"},
            "cacheMedium": {"enum": ["disk", "memory"]},
            "mountTimeoutSeconds": {"type": "integer", "minimum": 1},
            "flushTimeoutSeconds": {"type": "integer", "minimum": 1},
            "unmountTimeoutSeconds": {"type": "integer", "minimum": 1},
            "recreateMaxAttempts": {"type": "integer", "minimum": 0},
            "leaseTTLSeconds": {"type": "integer", "minimum": 1},
            "leaseRenewIntervalSeconds": {"type": "integer", "minimum": 1},
            "quotaMode": {"const": "soft"},
            "mounterResources": {"type": "object"},
            "fusePool": {"type": "object"},
            "lsmProfile": {"type": "string"}
          },
          "allOf": [
            {
              "if": {"properties": {"defaultMountMode": {"const": "sync"}}},
              "then": {"properties": {"enabledMountModes": {"contains": {"const": "sync"}}}}
            },
            {
              "if": {"properties": {"defaultMountMode": {"const": "fuse"}}},
              "then": {"properties": {"enabledMountModes": {"contains": {"const": "fuse"}}}}
            }
          ]
        }
      }
    }
  }
}
