{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "config": {
      "type": "object",
      "required": ["storage", "workspace"],
      "properties": {
        "storage": {
          "type": "object",
          "required": ["filesystem"],
          "properties": {
            "filesystem": {
              "type": "object",
              "additionalProperties": false,
              "required": ["preset", "bucket", "endpoint", "accessKey", "secretKey", "storageIdentity", "credentialGeneration", "systemEgressMode", "dnsCIDRs", "endpointPorts"],
              "properties": {
                "preset": {"enum": ["minio", "huawei-obs-public", "huawei-obs-private"]},
                "bucket": {"type": "string", "minLength": 1},
                "endpoint": {"type": "string", "minLength": 1},
                "accessKey": {"type": "string"},
                "secretKey": {"type": "string"},
                "storageIdentity": {"type": "string", "minLength": 1},
                "credentialGeneration": {"type": "string", "minLength": 1},
                "region": {"type": "string"},
                "caSecretKey": {"type": "string"},
                "endpointHostIPs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
                "systemEgressMode": {"enum": ["cidr", "cilium-fqdn"]},
                "dnsCIDRs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
                "systemEgressCIDRs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
                "endpointPorts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 65535}},
                "subPath": {"type": "string"},
                "useSSL": {"type": "boolean"}
              }
            }
          }
        },
        "workspace": {
          "type": "object",
          "additionalProperties": false,
          "required": ["defaultMountMode", "enabledMountModes", "fuseImages"],
          "properties": {
            "defaultMountMode": {"enum": ["sync", "fuse"]},
            "enabledMountModes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "uniqueItems": true,
              "items": {"enum": ["sync", "fuse"]}
            },
            "fuseImages": {
              "type": "object",
              "required": ["mounter", "docker"],
              "properties": {
                "mounter": {"type": "string", "pattern": "^(?:[^\\s@]+@sha256:[0-9a-f]{64}|[^\\s@]+:v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?)$"},
                "docker": {"type": "string", "pattern": "^(?:[^\\s@]+@sha256:[0-9a-f]{64}|[^\\s@]+:v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?)$"}
              }
            },
            "allowMissingLSMForKind": {"type": "boolean"},
            "autoSyncIntervalSeconds": {"type": "integer", "minimum": 0},
            "cacheSize": {"type": "string"},
            "cacheMedium": {"enum": ["disk", "memory"]},
            "mountTimeoutSeconds": {"type": "integer", "minimum": 1},
            "flushTimeoutSeconds": {"type": "integer", "minimum": 1},
            "unmountTimeoutSeconds": {"type": "integer", "minimum": 1},
            "recreateMaxAttempts": {"type": "integer", "minimum": 0},
            "leaseTTLSeconds": {"type": "integer", "minimum": 1},
            "leaseRenewIntervalSeconds": {"type": "integer", "minimum": 1},
            "quotaMode": {"const": "soft"},
            "mounterResources": {"type": "object"},
            "fusePool": {"type": "object"},
            "lsmProfile": {"type": "string"},
            "proxyURL": {"const": ""}
          },
          "allOf": [
            {
              "if": {"properties": {"defaultMountMode": {"const": "sync"}}},
              "then": {"properties": {"enabledMountModes": {"contains": {"const": "sync"}}}}
            },
            {
              "if": {"properties": {"defaultMountMode": {"const": "fuse"}}},
              "then": {"properties": {"enabledMountModes": {"contains": {"const": "fuse"}}}}
            }
          ]
        }
      }
    }
  }
}
