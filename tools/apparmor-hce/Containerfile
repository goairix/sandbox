# syntax=docker/dockerfile:1
ARG HCE_BUILDER_IMAGE
FROM ${HCE_BUILDER_IMAGE} AS build
ARG HCE_BUILDER_IMAGE
ARG TARGETARCH
ENV PYTHONDONTWRITEBYTECODE=1 LC_ALL=C
WORKDIR /work
# This context is assembled from an explicit local allowlist by build.sh.
COPY . /work/
RUN set -eu; . /etc/os-release; \
    test "${ID:-}" = hce && test "${VERSION_ID:-}" = 2.0; \
    case "$TARGETARCH" in amd64) expected=x86_64 ;; arm64) expected=aarch64 ;; *) exit 1 ;; esac; \
    test "$(uname -m)" = "$expected"
RUN dnf install -y --setopt=install_weak_deps=False \
      bash python3 rpm-build gcc gcc-c++ libstdc++-static make bison flex \
      autoconf automake libtool autoconf-archive pkgconfig \
      dejagnu perl perl-Test-Simple perl-Pod-Checker perl-podlators \
      pcre2-devel curl ca-certificates gnupg2 binutils tar gzip \
    && dnf clean all
RUN bash /work/check-sbin-layout.sh /
RUN --mount=type=secret,id=apparmor_trusted_keyring,required=true \
    python3 /work/lib/hce_stage.py build --arch "$TARGETARCH" --builder-image "$HCE_BUILDER_IMAGE"

# Start dependency/runtime checks from the supplied base again, without the
# compilers and build dependencies installed above masking missing Requires.
FROM ${HCE_BUILDER_IMAGE} AS audit
ARG HCE_BUILDER_IMAGE
ARG TARGETARCH
ENV PYTHONDONTWRITEBYTECODE=1 LC_ALL=C
RUN set -eu; . /etc/os-release; test "${ID:-}" = hce && test "${VERSION_ID:-}" = 2.0
RUN dnf install -y --setopt=install_weak_deps=False python3 rpm binutils gnupg2 \
    && dnf clean all
COPY lib /audit/lib/
COPY --from=build /out /out/
RUN --mount=type=secret,id=apparmor_trusted_keyring,required=true \
    python3 /audit/lib/hce_stage.py audit --arch "$TARGETARCH" --builder-image "$HCE_BUILDER_IMAGE"

FROM scratch AS export
COPY --from=audit /out/ /
