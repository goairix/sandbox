# syntax=docker/dockerfile:1
# The administrator must provide a digest-pinned HCE 2.0 builder image.
ARG HCE_BUILDER_IMAGE
FROM ${HCE_BUILDER_IMAGE}

ARG TARGETARCH
# The administrator supplies a read-only keyring path from the HCE builder;
# no key material is copied into this repository or generated here.
ARG APPARMOR_TRUSTED_KEYRING
ENV SOURCE_ROOT=/usr/src/apparmor
WORKDIR /usr/src

# Refuse to run in an arbitrary distribution or for a different execution
# architecture. TARGETARCH is supplied by the container builder (amd64 or
# arm64); no cross-architecture emulation is assumed. HCE's usr-merge layout
# gate makes the real %{_sbindir}/apparmor_parser reachable at /sbin/apparmor_parser
# without a wrapper or host mutation.
COPY check-sbin-layout.sh /usr/local/bin/check-sbin-layout.sh
RUN chmod 0755 /usr/local/bin/check-sbin-layout.sh
RUN set -eu; . /etc/os-release; \
    test "${ID:-}" = hce && test "${VERSION_ID:-}" = 2.0; \
    case "${TARGETARCH:-}" in amd64) expected=x86_64 ;; arm64) expected=aarch64 ;; *) echo 'unsupported TARGETARCH' >&2; exit 1 ;; esac; \
    test "$(uname -m)" = "$expected"

# Keep the lock file in the build context and fail before any source is
# fetched unless an administrator has recorded authoritative verification
# values.  This deliberately makes an unverified checkout unusable.
COPY source.lock /usr/src/source.lock
RUN set -eu; \
    awk -F= 'BEGIN { expected="version release_archive_url signature_url archive_sha256 trusted_public_key_fingerprint source_revision" } /^[[:space:]]*#/ || /^[[:space:]]*$/ { next } NF != 2 { exit 2 } $1 !~ /^(version|release_archive_url|signature_url|archive_sha256|trusted_public_key_fingerprint|source_revision)$/ { exit 3 } { count[$1]++; if ($1 != "version" && $2 ~ /UNVERIFIED|REQUIRED_FROM_/) exit 4 } END { for (key in count) if (count[key] != 1) exit 5; split(expected, keys, " "); for (i in keys) if (!count[keys[i]]) exit 6 }' /usr/src/source.lock; \
    version=$(sed -n 's/^version=//p' /usr/src/source.lock); \
    archive_url=$(sed -n 's/^release_archive_url=//p' /usr/src/source.lock); \
    signature_url=$(sed -n 's/^signature_url=//p' /usr/src/source.lock); \
    archive_sha=$(sed -n 's/^archive_sha256=//p' /usr/src/source.lock); \
    fingerprint=$(sed -n 's/^trusted_public_key_fingerprint=//p' /usr/src/source.lock); \
    revision=$(sed -n 's/^source_revision=//p' /usr/src/source.lock); \
    test "$version" = 4.1.7; \
    test "$archive_url" = https://github.com/apparmor/apparmor/releases/download/v4.1.7/apparmor-4.1.7.tar.gz; \
    test "$signature_url" = https://github.com/apparmor/apparmor/releases/download/v4.1.7/apparmor-4.1.7.tar.gz.asc; \
    printf '%s\n' "$archive_sha" | grep -Eq '^[0-9a-fA-F]{64}$'; \
    printf '%s\n' "$fingerprint" | grep -Eq '^[0-9a-fA-F]{40}$'; \
    printf '%s\n' "$revision" | grep -Eq '^[0-9a-fA-F]{40}$'; \
    test -n "${APPARMOR_TRUSTED_KEYRING:-}"; \
    test -r "${APPARMOR_TRUSTED_KEYRING}"

RUN dnf install -y --setopt=install_weak_deps=False \
      bash rpm-build gcc make bison flex pcre2 pcre2-devel curl ca-certificates gnupg2 git-core \
    && rpm -q bash rpm-build gcc make bison flex pcre2 pcre2-devel git-core \
    && dnf clean all

RUN /usr/local/bin/check-sbin-layout.sh /

RUN set -eu; \
    archive_url=$(sed -n 's/^release_archive_url=//p' /usr/src/source.lock); \
    signature_url=$(sed -n 's/^signature_url=//p' /usr/src/source.lock); \
    archive_sha=$(sed -n 's/^archive_sha256=//p' /usr/src/source.lock); \
    expected_fingerprint=$(sed -n 's/^trusted_public_key_fingerprint=//p' /usr/src/source.lock); \
    expected_revision=$(sed -n 's/^source_revision=//p' /usr/src/source.lock); \
    test -n "$archive_url" && test -n "$archive_sha"; \
    test -n "$signature_url" && test -n "$expected_fingerprint"; \
    tag_refs=$(git ls-remote --exit-code "https://github.com/apparmor/apparmor.git" \
      'refs/tags/v4.1.7' 'refs/tags/v4.1.7^{}'); \
    remote_revision=$(printf '%s\n' "$tag_refs" | awk '$2 == "refs/tags/v4.1.7^{}" { print $1 }'); \
    test -n "$remote_revision" || remote_revision=$(printf '%s\n' "$tag_refs" | awk '$2 == "refs/tags/v4.1.7" { print $1 }'); \
    test "$remote_revision" = "$expected_revision"; \
    curl --fail --location --proto '=https' --tlsv1.2 "$archive_url" -o /usr/src/apparmor.tar.gz; \
    printf '%s  %s\n' "$archive_sha" /usr/src/apparmor.tar.gz | sha256sum -c -; \
    curl --fail --location --proto '=https' --tlsv1.2 "$signature_url" -o /usr/src/apparmor.tar.gz.asc; \
    gpg_status=$(mktemp); trap 'rm -f "$gpg_status"' EXIT; \
    gpg --batch --no-default-keyring --keyring "$APPARMOR_TRUSTED_KEYRING" \
      --status-fd=3 --verify /usr/src/apparmor.tar.gz.asc /usr/src/apparmor.tar.gz \
      3>"$gpg_status"; \
    signer_count=$(awk '$1 == "[GNUPG:]" && $2 == "VALIDSIG" { count++; signer=$3 } END { print count+0 }' "$gpg_status"); \
    signer=$(awk '$1 == "[GNUPG:]" && $2 == "VALIDSIG" { print $3 }' "$gpg_status"); \
    test "$signer_count" = 1 && test "$signer" = "$expected_fingerprint"; \
    mkdir -p "$SOURCE_ROOT"; tar -xzf /usr/src/apparmor.tar.gz -C /usr/src; \
    test -d /usr/src/apparmor-4.1.7

WORKDIR /usr/src/apparmor-4.1.7
RUN set -eu; \
    make -C libraries/libapparmor; \
    make -C libraries/libapparmor check; \
    make -C parser

RUN set -eu; \
    rootfs=$(mktemp -d); \
    trap 'rm -rf "$rootfs"' EXIT; \
    mkdir -p "$rootfs/usr/sbin"; \
    cp -p parser/apparmor_parser "$rootfs/usr/sbin/apparmor_parser"; \
    ln -s usr/sbin "$rootfs/sbin"; \
    /usr/local/bin/check-sbin-layout.sh "$rootfs" /usr/sbin/apparmor_parser "$(uname -m)"

# rpmbuild installs only into its buildroot; no init system, host path, or
# service configuration is touched by this image.
COPY rpm/sandbox-apparmor-parser.spec /usr/src/sandbox-apparmor-parser.spec
RUN set -eu; \
    mkdir -p /usr/src/rpmbuild/SOURCES /usr/src/rpmbuild/SPECS; \
    cp /usr/src/apparmor.tar.gz /usr/src/rpmbuild/SOURCES/apparmor-4.1.7.tar.gz; \
    cp /usr/src/sandbox-apparmor-parser.spec /usr/src/rpmbuild/SPECS/; \
    rpmbuild -bb --define "_topdir /usr/src/rpmbuild" \
      /usr/src/rpmbuild/SPECS/sandbox-apparmor-parser.spec
